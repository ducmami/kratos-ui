# Sao chép thành .env. Không commit file .env.

# URL public API của Kratos, process này gọi tới.
KRATOS_PUBLIC_URL=http://127.0.0.1:4433

# URL trình duyệt dùng khi POST form. Để trống thì dùng KRATOS_PUBLIC_URL.
# KRATOS_BROWSER_URL=http://127.0.0.1:4433

# Có thể thay KRATOS_PUBLIC_URL (và HYDRA_ADMIN_URL nếu biến đó trống).
# ORY_SDK_URL=http://127.0.0.1:4433

PORT=3000

# Bắt buộc. Cookie CSRF ký bằng HMAC.
# Trên HTTP local không dùng tiền tố __Host- (trình duyệt đòi cookie Secure).
CSRF_COOKIE_NAME=kratos_ui_csrf
CSRF_COOKIE_SECRET=replace-with-at-least-8-chars

# Chỉ bật khi dev qua HTTP. Production để trống.
DANGEROUSLY_DISABLE_SECURE_CSRF_COOKIES=true

# --- Consent Hydra (tuỳ chọn) ---
# Route /consent chỉ bật khi có HYDRA_ADMIN_URL cùng hai biến CSRF ở trên.
# HYDRA_ADMIN_URL=http://127.0.0.1:4445
# ORY_ADMIN_API_TOKEN=
# Khi có ORY_ADMIN_API_TOKEN, COOKIE_SECRET phải dài ít nhất 8 ký tự.
# COOKIE_SECRET=replace-with-at-least-8-chars
# MOCK_TLS_TERMINATION=
# TRUSTED_CLIENT_IDS=
# SESSION_EXTRA_TRAITS_ID_TOKEN=
# SESSION_EXTRA_TRAITS_ACCESS_TOKEN=
# REMEMBER_CONSENT_SESSION_FOR_SECONDS=3600
# CONFORMITY_FAKE_CLAIMS=

# Tiền tố đường dẫn tĩnh, nếu app không chạy ở /.
# NEXT_PUBLIC_BASE_PATH=
